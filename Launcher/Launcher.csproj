    <!--    </Target>-->

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="xcopy /E /I /Y &quot;$(ProjectDir)Lib\ObtSDK.dll&quot; &quot;$(TargetDir)&quot;&#xA;if &quot;$(ConfigurationName)&quot; == &quot;Release&quot; (&#xA;..\obf\ObtOfc.exe $(ProjectDir)config.json&#xA;)&#xA;&#xA;del &quot;$(TargetDir)*.pdb&quot;&#xA;" />
    </Target>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <Exec Command="xcopy /E /I /Y &quot;$(ProjectDir)Lib\*&quot; &quot;$(TargetDir)&quot;"/>
    </Target>
</Project>
