<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net462</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <Company>Ông bán tất</Company>
        <Product>AUTO_SANDBOX</Product>
        <AssemblyVersion>1.4</AssemblyVersion>
        <FileVersion>1.4</FileVersion>
        <NeutralLanguage>vi</NeutralLanguage>
        <AssemblyName>Launcher</AssemblyName>
        <ApplicationIcon>assets\logo.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
        <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="KAutoHelper">
          <HintPath>..\Lib\KAutoHelper.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CSharp"/>
        <Reference Include="System.Net.Http"/>
        <Reference Include="System.Windows.Forms"/>
        <Reference Include="WindowsFormsIntegration"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Lib\ObtSDK.dll">
          <Link>ObtSDK.dll</Link>
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\concrt140.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\cvextern.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\Emgu.CV.World.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\KAutoHelper.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\msvcp140.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\opencv_ffmpeg343.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Update="..\..\..\.nuget\packages\obtsdk\1.5.0\contentFiles\any\net462\vcruntime140.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="ObtSDK" Version="1.5.0" />
        <PackageReference Include="PaddleOCRSharp" Version="4.4.0.2" />
        <PackageReference Include="Sentry" Version="5.1.1"/>
    </ItemGroup>


 

    <ItemGroup>
        <None Update="adb\adb.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="adb\ADBKeyboard.apk">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="adb\AdbWinApi.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="adb\AdbWinUsbApi.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="adb\clipper.apk">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="key.snk" />
        <None Remove="config.json" />
        <None Remove="PostBuild.ps1" />
    </ItemGroup>
 

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="if &quot;$(ConfigurationName)&quot; == &quot;Release&quot; (&#xA;..\obf\ObtOfc.exe $(ProjectDir)config.json&#xA;del &quot;$(TargetDir)*.pdb&quot;&#xA;powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)\PostBuild.ps1&quot; -TargetDir $(TargetDir)&#xA;)&#xA;" />
    </Target>
</Project>
